# Copy to .env. Everything except GEMINI_API_KEY and TAVILY_API_KEY has a working default for local development.
# After editing .env: docker compose -f infrastructure/docker-compose.yml up -d --force-recreate worker

# Embeddings (docs/decisions.md Q1). Provider: gemini | openai (OpenAI or any OpenAI-compatible local server)
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Gemini free tier allows 30k embedding tokens/minute; raise on paid tiers for fewer requests.
EMBEDDING_BATCH_TOKENS=20000
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # e.g. http://127.0.0.1:11434/v1 for Ollama

# Chat model for parsing and research planning. A comma-separated list is a preference order: when one is
# overloaded or rate-limited, the next answers (docs/decisions.md D11). LLM_PROVIDER: gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL_FAST=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Lessons (Phase 4): pro is first but has no free-tier quota; the list falls through to flash / flash-lite.
LLM_MODEL_SMART=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
LESSON_DEFAULT_DEPTH=detailed
# Monthly AI budget per workspace (0 = unlimited): chat tokens and web searches
WORKSPACE_MONTHLY_TOKENS=3000000
WORKSPACE_MONTHLY_SEARCHES=500
# ...and per person across all their workspaces (docs/decisions.md D30)
USER_MONTHLY_TOKENS=1500000

# Accounts (docs/decisions.md D25). SECRET_KEY signs access tokens: generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty = a random key per process, which signs everyone out on every restart.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# COOKIE_SECURE: true behind HTTPS (production)
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
# Where the frontend runs: links in emails point here
APP_URL=http://127.0.0.1:5173
# Email (A19, D34). Development: Mailpit from docker compose, inbox at http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=SemSaviour <no-reply@semsaviour.local>

# Web research (Phase 3): Tavily key, and the per-topic budget (PRD E4)
TAVILY_API_KEY=
RESEARCH_MAX_QUERIES=4
RESEARCH_MAX_SOURCES=8
RESEARCH_REUSE_DAYS=7
# Minimum similarity for a material passage to count toward a syllabus topic (D12)
TOPIC_MATCH_THRESHOLD=0.6

# Services from infrastructure/docker-compose.yml, as seen from the host.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls against Docker.
DATABASE_URL=postgresql+psycopg://semsaviour:semsaviour@127.0.0.1:5432/semsaviour
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=semsaviour
S3_ACCESS_KEY=semsaviour
S3_SECRET_KEY=semsaviour-secret

LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
# Chunking (PRD D4), estimated tokens
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=300
CHUNK_OVERLAP_TOKENS=100
# Retrieval (PRD D6)
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=8
